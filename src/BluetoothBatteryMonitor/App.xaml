<Application x:Class="BluetoothBatteryMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Fluent Dark Theme Temel Renkleri -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EE202020" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#404040" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0" />
        <SolidColorBrush x:Key="AccentColorBrush" Color="#0078D7" />
    </Application.Resources>
</Application>
