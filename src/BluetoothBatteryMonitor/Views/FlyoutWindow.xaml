<Window x:Class="BluetoothBatteryMonitor.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:BluetoothBatteryMonitor.Views"
        xmlns:viewmodels="clr-namespace:BluetoothBatteryMonitor.ViewModels"
        mc:Ignorable="d"
        Title="Bluetooth Pil Monitörü"
        Width="380" 
        Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainFlyoutViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FluentIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ana Dış Çerçeve: Yumuşak Gölgeli ve Yuvarlatılmış Köşeli -->
    <Border Margin="10" 
            Background="#EE202020" 
            BorderBrush="#44FFFFFF" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" 
                              ShadowDepth="4" 
                              Direction="270" 
                              Color="#000000" 
                              Opacity="0.55" />
        </Border.Effect>

        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. BAŞLIK ÇUBUĞU (HEADER) -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Bluetooth Logosu -->
                <TextBlock Grid.Column="0" 
                           Text="&#xE702;" 
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                           FontSize="18" 
                           Foreground="#0078D7" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,0" />

                <!-- Başlık -->
                <TextBlock Grid.Column="1" 
                           Text="Bluetooth Pilleri" 
                           FontSize="15" 
                           FontWeight="SemiBold" 
                           Foreground="#FFFFFF" 
                           VerticalAlignment="Center" />

                <!-- Yenile Butonu -->
                <Button Grid.Column="2" 
                        Style="{StaticResource FluentIconButton}" 
                        Command="{Binding RefreshCommand}" 
                        ToolTip="Cihazları ve Pilleri Yenile"
                        Margin="0,0,4,0">
                    <TextBlock Text="&#xE72C;" 
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="14" />
                </Button>

                <!-- Windows Bluetooth Ayarları Butonu -->
                <Button Grid.Column="3" 
                        Style="{StaticResource FluentIconButton}" 
                        Command="{Binding OpenBluetoothSettingsCommand}" 
                        ToolTip="Windows Bluetooth Ayarlarını Aç">
                    <TextBlock Text="&#xE713;" 
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="14" />
                </Button>
            </Grid>

            <!-- 2. İÇERİK BÖLGESİ (CİHAZ LİSTESİ VEYA BOŞ DURUM) -->
            <Grid Grid.Row="1">
                
                <!-- Cihaz Listesi -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:DeviceCardViewModel}">
                                <views:DeviceCardControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Boş Durum (Cihaz Yokken) -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Margin="20">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDevices}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <TextBlock Text="&#xE702;" 
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="42" 
                               Foreground="#555555" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,12" />
                    
                    <TextBlock Text="Bağlı Bluetooth Cihazı Yok" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="#D0D0D0" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,4" />
                    
                    <TextBlock Text="Aygıtlarınızın Bluetooth bağlantısını açın veya Windows Ayarları'ndan eşleştirin." 
                               FontSize="12" 
                               Foreground="#888888" 
                               TextAlignment="Center" 
                               TextWrapping="Wrap" 
                               MaxWidth="260" />

                    <Button Command="{Binding RefreshCommand}" 
                            Content="Cihazları Tara" 
                            Background="#333333" 
                            Foreground="#FFFFFF" 
                            BorderBrush="#555555" 
                            BorderThickness="1"
                            Padding="14,6" 
                            Margin="0,16,0,0" 
                            HorizontalAlignment="Center" 
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

            </Grid>

            <!-- 3. ALT BİLGİ VE AYARLAR (FOOTER) -->
            <Border Grid.Row="2" 
                    BorderBrush="#25FFFFFF" 
                    BorderThickness="0,1,0,0" 
                    Padding="0,10,0,0" 
                    Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Windows ile Başlat Seçeneği -->
                    <CheckBox IsChecked="{Binding IsRunAtStartup}" 
                              Command="{Binding ToggleStartupCommand}"
                              VerticalAlignment="Center" 
                              Cursor="Hand">
                        <TextBlock Text="Windows ile Başlat" 
                                   FontSize="11.5" 
                                   Foreground="#AAAAAA" />
                    </CheckBox>

                    <!-- Çıkış Butonu -->
                    <Button Grid.Column="1" 
                            Command="{Binding ExitAppCommand}" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="#888888" 
                            FontSize="11.5" 
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text="Çıkış" />
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#EF4444" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
