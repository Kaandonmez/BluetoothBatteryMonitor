<ui:FluentWindow x:Class="BluetoothBatteryMonitor.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{DynamicResource About_Title}"
        Width="460"
        Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header and Logo -->
        <StackPanel Grid.Row="0" Margin="0,10,0,16" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/BluetoothBatteryMonitor.App;component/Assets/app.ico"
                   Width="64" Height="64"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />

            <TextBlock Text="{DynamicResource About_AppName}"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Padding="8,2"
                        CornerRadius="4">
                    <TextBlock Text="{DynamicResource About_Version}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Content Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <Border Margin="0,0,0,12"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About_Overview}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource About_OverviewText}"
                                   FontSize="12.5"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,12"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About_Features}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="{DynamicResource About_Feature1}"
                                   FontSize="12"
                                   Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{DynamicResource About_Feature2}"
                                   FontSize="12"
                                   Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{DynamicResource About_Feature3}"
                                   FontSize="12"
                                   Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{DynamicResource About_Feature4}"
                                   FontSize="12"
                                   Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{DynamicResource About_Feature5}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="{DynamicResource Update_CheckNow}"
                    HorizontalAlignment="Left"
                    Click="OnCheckUpdatesClick"
                    Padding="14,6" />

            <Button Content="{DynamicResource About_Close}"
                    HorizontalAlignment="Right"
                    Click="OnCloseClick"
                    Padding="24,6" />
        </Grid>
    </Grid>
</ui:FluentWindow>
